# =============================================================================
# .env.production.example
# Copy to .env.production on the deployment VM and replace all placeholder
# values. Do NOT commit the real .env.production file to the repository.
# =============================================================================

# ---------- Django ----------
SECRET_KEY=CAMBIAR_POR_UNA_LLAVE_LARGA_SEGURA
DEBUG=False
# Comma-separated list of hostnames/IPs Django will serve (no scheme).
ALLOWED_HOSTS=IP_PUBLICA,localhost,127.0.0.1
# Comma-separated list of frontend origins allowed for CORS (with scheme).
CORS_ALLOWED_ORIGINS=http://IP_PUBLICA,http://IP_PUBLICA:3000
# Comma-separated list of origins trusted for CSRF (with scheme).
CSRF_TRUSTED_ORIGINS=http://IP_PUBLICA,http://IP_PUBLICA:3000

# ---------- Database (PostgreSQL inside docker-compose) ----------
POSTGRES_DB=gol90store
POSTGRES_USER=gol90user
POSTGRES_PASSWORD=CAMBIAR_PASSWORD_SEGURA
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ---------- Frontend ----------
# Public URL the browser will use to call the backend API.
NEXT_PUBLIC_API_URL=http://IP_PUBLICA:8000

# ---------- Demo data ----------
# Set to "true" only on the first boot if you want seed_demo to run
# automatically. Keep "false" in normal operation; load demo data manually
# with: docker compose -f docker-compose.production.yml exec backend \
#       python manage.py seed_demo
SEED_DEMO_ON_START=false

# ---------- Gunicorn (optional tuning) ----------
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60
